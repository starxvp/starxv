PORT=3000
NODE_ENV=development
# SMTP is required for real verification emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=STARXV <no-reply@starxv.pl>
# Public production URL used for same-origin security checks
PUBLIC_URL=https://starxv.pl

# InPost (keep private values only in Render environment variables)
INPOST_TOKEN=
INPOST_ORGANIZATION_ID=
INPOST_GEOWIDGET_TOKEN=
INPOST_WEBHOOK_SECRET=
INPOST_API_BASE=https://api-shipx-pl.easypack24.net/v1
INPOST_POINTS_API_BASE=https://api.inpost.pl/v1
INPOST_PARCEL_TEMPLATE=small
INPOST_LOCKER_PRICE=14.99
INPOST_COURIER_PRICE=19.99
FREE_SHIPPING_FROM=0

# Przelewy24 (keep all credentials private; configure them in server environment variables)
# Start with sandbox=true. Do not put these values in public/index.html or any frontend file.
P24_MERCHANT_ID=
P24_POS_ID=
P24_API_KEY=
P24_CRC=
P24_SANDBOX=true
